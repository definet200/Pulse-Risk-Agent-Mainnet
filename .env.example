# Server secrets (generate with: openssl rand -hex 32)
SESSION_SECRET=
KEYSTORE_SECRET=
# Bearer token the agent service uses for /api/agent/v1/*
AGENT_API_TOKEN=
# Docker / Lightsail: public hostname Caddy gets an HTTPS certificate for (an A record pointing at the
# instance's static IP, or <static-ip>.sslip.io if you have no domain). Not used by `npm run dev`.
DOMAIN=
# Optional
DB_PATH=./data/pulsarx.db
NEXT_PUBLIC_BSC_RPC_URL=
NEXT_PUBLIC_ETH_RPC_URL=
NEXT_PUBLIC_ARB_RPC_URL=
RELAY_API_KEY=
AGENT_BSC_ADDRESS=
