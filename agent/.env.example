# ── App API (same value as AGENT_API_TOKEN in the app's .env.local) ──
APP_API_URL=http://localhost:3100
AGENT_API_TOKEN=

# ── Network the loop works on: mainnet | testnet ──
AGENT_NETWORK=testnet
TICK_INTERVAL_SEC=30

# ── Safety switches ──
# DRY_RUN=true  : never sign or send anything; steps are simulated and logged.
DRY_RUN=true
# Live execution needs BOTH DRY_RUN=false and ALLOW_LIVE=yes-i-understand
ALLOW_LIVE=no
# Post decisions/events to the app (/api/agent/v1/events + rule-state)
POST_EVENTS=true

# ── LLM via OpenRouter (LLM_MODE=off → code picks the top candidate, no LLM calls) ──
LLM_MODE=on
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Verify slugs on https://openrouter.ai/models
LLM_MODEL_ANALYST=anthropic/claude-sonnet-4.5
LLM_MODEL_DECIDER=anthropic/claude-sonnet-4.5
LLM_MODEL_REVIEWER=anthropic/claude-sonnet-4.5
LLM_MODEL_REPORTER=anthropic/claude-haiku-4.5
LLM_MODEL_RISK_ANALYST=anthropic/claude-sonnet-4.5
LLM_MODEL_NEWS_ANALYST=anthropic/claude-sonnet-4.5
# Comma-separated OpenRouter fallbacks tried if the model above fails
LLM_FALLBACK_MODELS=
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1

# ── Risk-analyst proposals (rule thresholds fitted to volatility, latency, leverage) ──
PROPOSE_INTERVAL_SEC=300
PROPOSE_MAX_UTIL=0.9
PROPOSE_K_SIGMA=3
PROPOSE_VOL_STRESS=2
PROPOSE_MIN_TRIGGER=0.4
PROPOSE_MAX_TRIGGER=0.8
DEFAULT_LATENCY_SEC=60

# ── News-driven hedging (free RSS: Google News + Yahoo Finance, no key) ──
NEWS_TTL_SEC=600
NEWS_MAX_AGE_HOURS=48
NEWS_MIN_SIGNAL=0.3
# Confirmation mode: re-ask about the same move at most once per this many seconds
ACTION_BUCKET_SEC=600

DERIVE_ETA_SEC=1800
# ── Anomaly stop: too many intents or refusals in the window pauses the agent ──
ANOMALY_MAX_INTENTS=12
ANOMALY_MAX_REFUSALS=6
ANOMALY_WINDOW_SEC=600
PAUSE_MIN=30

# ── Agent BSC wallet (the EOA holding gas; key stays here only) ──
AGENT_BSC_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ETH_RPC_URL=
RELAY_API_KEY=

# ── Local state ──
AGENT_DB_PATH=./data/agent.db
LIGHTER_WASM_DIR=../vendor/lighter
LOG_LEVEL=info
